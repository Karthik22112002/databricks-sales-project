   "source": [
    "df_s = spark.table(\"bronze_sales\")\n",
    "from pyspark.sql.functions import *\n",
    "silver_df = df_s.withColumn(\"Revenue\", col(\"quantity\") * col(\"price\") )\n",
    "display(silver_df)\n",
    "silver_df.write.mode(\"overwrite\").saveAsTable(\"silver_sales\")\n"
   ]
